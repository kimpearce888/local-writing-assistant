{
  "name": "local-writing-assistant-extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Fully local AI writing assistant Chrome extension powered by LM Studio. No cloud, no telemetry.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && vite build --mode content",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist extension/dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
